@{ ViewData["Title"] = "Worker Dashboard"; }

<div class="container py-4">
    <h3 class="mb-4">&#9881; Outbox Worker Dashboard</h3>

    <div class="row g-3 mb-4">

        @* Worker Control *@
        <div class="col-md-5">
            <div class="card h-100" id="workerCard">
                <div class="card-header fw-bold">&#128272; Worker Control</div>
                <div class="card-body d-flex flex-column gap-3">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success py-2 small mb-0">@TempData["Success"]</div>
                    }

                    @* Vùng 1: Trạng thái worker *@
                    <div class="border rounded p-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="fs-5" id="workerIcon">&#9679;</span>
                            <span id="workerStatus" class="fw-bold fs-5">Đang tải...</span>
                        </div>
                        <div class="text-muted small mb-2">
                            Poll OutboxEvents mỗi <strong>5 giây</strong> — tạm dừng để simulate out-of-sync.
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-warning btn-sm" id="btnPause" onclick="workerAction('Pause')">⏸ Tạm dừng</button>
                            <button class="btn btn-success btn-sm" id="btnResume" onclick="workerAction('Resume')">▶ Chạy lại</button>
                        </div>
                        <div class="mt-2 text-muted small" id="workerMeta"></div>
                    </div>

                    @* Vùng 2: Seed dữ liệu *@
                    <div class="border rounded p-3">
                        <div class="fw-semibold small mb-2">&#127807; Seed dữ liệu mẫu</div>
                        <div class="text-muted small mb-2">SQL Server → OutboxEvents → ES</div>
                        <div class="d-flex gap-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <select id="seedCountSelect" class="form-select form-select-sm" style="width:180px">
                                <option value="50">50 records</option>
                                <option value="200" selected>200 records</option>
                                <option value="500">500 records</option>
                                <option value="1000">1.000 records</option>
                                <option value="10000">10.000 records</option>
                                <option value="100000">100.000 records</option>
                                <option value="500000">500.000 records</option>
                                <option value="1000000">1.000.000 records</option>
                                <option value="5000000">5.000.000 records</option>
                            </select>
                            <button class="btn btn-outline-primary btn-sm" onclick="doSeed()">Seed thêm</button>
                        </div>
                        <div id="seedProgress" class="mt-2" style="display:none">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span id="seedLabel">Đang seed...</span>
                                <span id="seedCount">0 / 0</span>
                            </div>
                            <div class="progress" style="height:6px">
                                <div id="seedBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width:0%"></div>
                            </div>
                            <div id="seedDoneText" class="small text-success mt-1" style="display:none"></div>
                            <div id="seedElapsed" class="small text-muted mt-1" style="display:none"></div>
                        </div>
                    </div>

                    @* Vùng 3: Bảo trì *@
                    <div class="border rounded p-3">
                        <div class="fw-semibold small mb-2">&#9881; Bảo trì</div>
                        <div class="d-flex flex-column gap-2">
                            <button class="btn btn-outline-danger btn-sm" id="btnRetry" onclick="retryFailed()">
                                ↩ Retry Failed — sync lại event lỗi
                            </button>
                            <button class="btn btn-outline-warning btn-sm" onclick="doForceResync()">
                                &#128257; Reindex ES từ SQL
                            </button>
                            <form asp-action="ClearAll" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger btn-sm w-100"
                                        onclick="return confirm('Xóa TOÀN BỘ data SQL + ES? Không thể hoàn tác!')">
                                    &#128465; Xóa hết SQL + ES
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        @* Sync Status *@
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header fw-bold">&#128202; Sync Status</div>
                <div class="card-body">
                    <div class="row g-3 text-center">
                        <div class="col-4">
                            <div class="border rounded p-3">
                                <div class="text-muted small">SQL (source)</div>
                                <div class="fs-4 fw-bold text-primary" id="sqlCount">—</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-3">
                                <div class="text-muted small">Elasticsearch</div>
                                <div class="fs-4 fw-bold text-success" id="esCount">—</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border rounded p-3">
                                <div class="text-muted small">Lệch</div>
                                <div class="fs-4 fw-bold" id="diffCount">—</div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="row text-center g-2 small">
                        <div class="col-4">
                            <span class="badge bg-warning text-dark fs-6" id="pendingCount">—</span>
                            <div class="text-muted">Pending</div>
                        </div>
                        <div class="col-4">
                            <span class="badge bg-success fs-6" id="doneCount">—</span>
                            <div class="text-muted">Processed</div>
                        </div>
                        <div class="col-4">
                            <span class="badge bg-danger fs-6" id="failedCount">—</span>
                            <div class="text-muted">Failed</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Recent Events *@
    <div class="card">
        <div class="card-header fw-bold d-flex justify-content-between">
            <span>&#128203; Outbox Events gần nhất</span>
            <span class="text-muted small" id="lastUpdate"></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>ProductId</th>
                            <th>EventType</th>
                            <th>Status</th>
                            <th>Tạo lúc</th>
                            <th>Xử lý lúc</th>
                            <th>Lỗi</th>
                        </tr>
                    </thead>
                    <tbody id="eventsBody">
                        <tr><td colspan="7" class="text-center text-muted py-3">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const statsUrl   = '@Url.Action("Stats", "Worker")';
    const pauseUrl   = '@Url.Action("Pause", "Worker")';
    const resumeUrl  = '@Url.Action("Resume", "Worker")';
    const csrfToken  = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

    const retryUrl   = '@Url.Action("RetryFailed", "Worker")';
    const resyncUrl  = '@Url.Action("ForceResync", "Worker")';

    async function retryFailed() {
        const btn = document.getElementById('btnRetry');
        btn.disabled = true;
        btn.textContent = '↩ Đang reset...';
        const res  = await fetch(retryUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `__RequestVerificationToken=${encodeURIComponent(csrfToken())}`
        });
        const data = await res.json();
        btn.disabled = false;
        btn.textContent = '↩ Retry Failed';
        await refresh();
        if (data.count === 0)
            alert('Không có event Failed nào.');
        else
            alert(`Đang retry ${data.count.toLocaleString('vi-VN')} event Failed — theo dõi qua dashboard.`);
    }

    async function doForceResync() {
        if (!confirm('Xóa index ES và reindex lại toàn bộ từ SQL?\nData ES sẽ mất trong lúc sync.')) return;
        const res  = await fetch(resyncUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `__RequestVerificationToken=${encodeURIComponent(csrfToken())}`
        });
        const data = await res.json();
        if (!data.started) { alert(data.message); return; }
        // reset progress UI
        document.getElementById('seedProgress').style.display = 'block';
        document.getElementById('seedLabel').textContent = 'Đang reindex...';
        document.getElementById('seedCount').textContent = `0 / ${data.total.toLocaleString('vi-VN')}`;
        document.getElementById('seedBar').style.width = '0%';
        document.getElementById('seedBar').classList.add('progress-bar-animated');
        document.getElementById('seedDoneText').style.display = 'none';
        document.getElementById('seedElapsed').style.display = 'none';
        if (!seedTimer) seedTimer = setInterval(refreshSeedProgress, 500);
    }

    async function workerAction(action) {
        const running = action === 'Resume';
        // Cập nhật UI ngay, không chờ server
        document.getElementById('workerStatus').textContent = running ? 'Đang chạy' : 'Đã tạm dừng';
        document.getElementById('workerIcon').style.color   = running ? '#198754' : '#dc3545';
        document.getElementById('btnPause').disabled  = !running;
        document.getElementById('btnResume').disabled = running;

        const url = action === 'Pause' ? pauseUrl : resumeUrl;
        await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `__RequestVerificationToken=${encodeURIComponent(csrfToken())}`
        });
        await refresh(); // sync lại với server sau khi POST xong
    }

    const statusBadge = {
        'Pending':   '<span class="badge bg-warning text-dark">Pending</span>',
        'Processed': '<span class="badge bg-success">Processed</span>',
        'Failed':    '<span class="badge bg-danger">Failed</span>',
    };

    const eventBadge = {
        'ProductCreated': '<span class="badge bg-primary">Created</span>',
        'ProductUpdated': '<span class="badge bg-info text-dark">Updated</span>',
        'ProductDeleted': '<span class="badge bg-dark">Deleted</span>',
    };

    async function refresh() {
        try {
            const res  = await fetch(statsUrl);
            const data = await res.json();

            // Worker status
            const running = data.workerRunning;
            document.getElementById('workerStatus').textContent = running ? 'Đang chạy' : 'Đã tạm dừng';
            document.getElementById('workerIcon').style.color   = running ? '#198754' : '#dc3545';
            document.getElementById('btnPause').disabled  = !running;
            document.getElementById('btnResume').disabled = running;
            document.getElementById('workerMeta').innerHTML =
                `Đã xử lý: <strong>${data.processedTotal}</strong> &nbsp;|&nbsp; ` +
                `Lỗi: <strong>${data.failedTotal}</strong> &nbsp;|&nbsp; ` +
                `Lần cuối: <strong>${data.lastRunAt ?? '—'}</strong>`;

            // Sync status
            document.getElementById('sqlCount').textContent  = Number(data.sqlCount).toLocaleString('vi-VN');
            document.getElementById('esCount').textContent   = Number(data.esCount).toLocaleString('vi-VN');

            const diff = Math.abs(data.sqlCount - data.esCount);
            const diffEl = document.getElementById('diffCount');
            diffEl.textContent  = diff === 0 ? '✓ 0' : `⚠️ ${Number(diff).toLocaleString('vi-VN')}`;
            diffEl.className    = `fs-4 fw-bold ${diff === 0 ? 'text-success' : 'text-danger'}`;

            document.getElementById('pendingCount').textContent = data.pendingCount;
            document.getElementById('doneCount').textContent    = data.doneCount;
            document.getElementById('failedCount').textContent  = data.failedCount;

            // Events table
            const rows = data.recentEvents.map(e => `
                <tr>
                    <td class="text-muted">${e.id}</td>
                    <td>${e.entityId}</td>
                    <td>${eventBadge[e.eventType] ?? e.eventType}</td>
                    <td>${statusBadge[e.status] ?? e.status}</td>
                    <td class="small">${e.createdAt}</td>
                    <td class="small">${e.processedAt ?? '—'}</td>
                    <td class="small text-danger">${e.errorMessage ?? ''}</td>
                </tr>`).join('');
            document.getElementById('eventsBody').innerHTML =
                rows || '<tr><td colspan="7" class="text-center text-muted">Chưa có event nào</td></tr>';

            document.getElementById('lastUpdate').textContent =
                'Cập nhật: ' + new Date().toLocaleTimeString('vi-VN');

        } catch(e) {
            console.error(e);
        }
    }

    async function pollRefresh() {
        await refresh();
        setTimeout(pollRefresh, 3000);
    }
    pollRefresh();

    // Seed không reload page
    async function doSeed() {
        const count = document.getElementById('seedCountSelect').value;
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        // Bắt đầu poll trước khi fetch — tránh miss progress với seed nhỏ
        if (!seedTimer) seedTimer = setInterval(refreshSeedProgress, 500);

        await fetch('/Worker/SeedSqlServer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `count=${count}&__RequestVerificationToken=${encodeURIComponent(token)}`
        });
    }

    // Poll seed progress — chỉ chạy khi đang seed, tự dừng khi xong
    let seedTimer = null;

    function formatElapsed(secs) {
        if (secs < 60) return `${secs}s`;
        const m = Math.floor(secs / 60), s = secs % 60;
        return s > 0 ? `${m} phút ${s}s` : `${m} phút`;
    }

    async function refreshSeedProgress() {
        try {
            const r = await fetch('/Worker/SeedProgress');
            const d = await r.json();
            const el = document.getElementById('seedProgress');

            if (d.isRunning) {
                el.style.display = 'block';
                document.getElementById('seedLabel').textContent = 'Đang seed...';
                document.getElementById('seedCount').textContent =
                    d.indexed.toLocaleString('vi-VN') + ' / ' + d.total.toLocaleString('vi-VN');
                document.getElementById('seedBar').style.width = d.percent + '%';
                document.getElementById('seedBar').classList.add('progress-bar-animated');
                document.getElementById('seedDoneText').style.display = 'none';
                document.getElementById('seedElapsed').style.display = 'block';
                document.getElementById('seedElapsed').textContent = `⏱ ${formatElapsed(d.elapsedSeconds)}`;
            } else if (d.indexed > 0) {
                // Xong — giữ nguyên progress bar, hiện text kết quả
                el.style.display = 'block';
                document.getElementById('seedLabel').textContent = 'Hoàn thành';
                document.getElementById('seedCount').textContent =
                    d.indexed.toLocaleString('vi-VN') + ' / ' + d.total.toLocaleString('vi-VN');
                document.getElementById('seedBar').style.width = '100%';
                document.getElementById('seedBar').classList.remove('progress-bar-animated');
                document.getElementById('seedDoneText').style.display = 'block';
                document.getElementById('seedDoneText').textContent =
                    `✓ Đã xử lý ${d.indexed.toLocaleString('vi-VN')} bản ghi`;
                document.getElementById('seedElapsed').style.display = 'block';
                document.getElementById('seedElapsed').textContent = `⏱ Hoàn thành sau ${formatElapsed(d.elapsedSeconds)}`;
                if (seedTimer) { clearInterval(seedTimer); seedTimer = null; }
            }
        } catch(e) {}
    }

    // Khi submit form seed → bắt đầu poll
    document.querySelector('form[action*="SeedSqlServer"]')?.addEventListener('submit', () => {
        if (!seedTimer) {
            setTimeout(() => { // delay nhỏ để server kịp nhận request
                seedTimer = setInterval(refreshSeedProgress, 1000);
            }, 500);
        }
    });

    // Khi load page: nếu đang seed dở thì tự động poll tiếp
    refreshSeedProgress().then(() => {
        const el = document.getElementById('seedProgress');
        if (el.style.display !== 'none') {
            seedTimer = setInterval(refreshSeedProgress, 1000);
        }
    });
</script>
}
